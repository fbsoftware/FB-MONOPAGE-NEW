"FB Print to console": {
	 	"scope": "javascript,typescript",
	 	"prefix": "fb-log",
	 	"body":
		[
			"console.log('$1');// FB: log",
	 		"$2"
	 	],
	 	"description": "Log output to console"
	 },

"FB Inspector Select Quick": {
  "prefix": "fb-select",
  "body": [
    "${1:select}:{",
    "  type:\"select\",",
    "  label:\"${2:Label}\",",
    "  options:{",
    "    ${3:value1:\"Label1\",",
    "    value2:\"Label2\"}",
    "  }",
    "},"
  ]
},

"FB Widget Number Field Quick": {
  "prefix": "fb-wn",
  "body": [
    "${1:padding}:{ type:\"number\", label:\"${2:Padding px}\" },"
  ]
},	

"FB Widget Color Field Quick": {
  "prefix": "fb-wc",
  "body": [
    "${1:color}:{ type:\"color\", label:\"${2:Colore}\" },"
  ]
},

  "FB Widget Align Select Full": {
