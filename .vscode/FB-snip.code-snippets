      "    options:{",
      "        left:\"Sinistra\",",
      "        center:\"Centro\",",
      "        right:\"Destra\",",
      "        justify:\"Giustificato\"",
      "    }",
      "},"
    ]
  },
  
  "FB Widget Align Select": {
    "prefix": "fb-wallin",
    "body": [
      "align:{",
      "    type:\"select\",",
      "    label:\"Allineamento\",",
      "    options:{",
      "        left:\"Sinistra\",",
      "        center:\"Centro\",",
      "        right:\"Destra\",",
      "    }",
      "},"
    ]
  },
  
  "FB Widget Padding": {
    "prefix": "fb-padding",
    "body": [  	
	  "padding:{ type:\"number\", label:\"Padding px\" },"
	]	
	},
  
  "FB Widget Margin": {
    "prefix": "fb-margin",
    "body":[
		"margin:{ type:\"number\", label:\"Margin px\" },"
	]
  },

   "FB Widget select color": {
